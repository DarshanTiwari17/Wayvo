# Server-only Supabase Edge Function secrets. Never copy these into .env or
# prefix them with VITE_. Set real values in the ignored .env.edge file.
RAILRADAR_API_KEY=
RAILRADAR_MONITORING_SECRET=

# Optional poller tuning.
RAILRADAR_STALE_AFTER_SECONDS=600
RAILRADAR_LOOKAHEAD_DAYS=3
RAILRADAR_LOOKBACK_HOURS=24