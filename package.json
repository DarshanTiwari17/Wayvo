{
  "name": "wayvo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend:dev": "node backend/server.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:parser": "esbuild scripts/test-booking-parser.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/parser.mjs --log-level=warning && node node_modules/.cache/parser.mjs",
    "test:itinerary": "esbuild scripts/test-itinerary.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/itinerary.mjs --log-level=warning && node node_modules/.cache/itinerary.mjs",
    "test:navigation": "esbuild scripts/test-navigation.ts --bundle --platform=node --format=esm --define:import.meta.env.VITE_SUPABASE_URL=undefined --define:import.meta.env.VITE_SUPABASE_ANON_KEY=undefined --define:import.meta.env.VITE_SUPABASE_EMAIL_REDIRECT_URL=undefined --outfile=node_modules/.cache/navigation.mjs --log-level=warning && node node_modules/.cache/navigation.mjs",
    "test:gmail": "esbuild scripts/test-gmail-flow.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/gmail-flow.mjs --log-level=warning && node node_modules/.cache/gmail-flow.mjs",
    "test:functions": "esbuild scripts/test-gmail-functions.ts --bundle --platform=node --format=esm --external:esbuild --outfile=node_modules/.cache/gmail-functions.mjs --log-level=warning && node node_modules/.cache/gmail-functions.mjs",
    "test": "npm run test:migrations && npm run test:parser && npm run test:itinerary && npm run test:gmail && npm run test:functions",
    "test:migrations": "esbuild scripts/test-migrations.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/migrations.mjs --log-level=warning && node node_modules/.cache/migrations.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.542.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.25.10",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
