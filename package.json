{
  "name": "wayvo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:parser": "esbuild scripts/test-booking-parser.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/parser.mjs --log-level=warning && node node_modules/.cache/parser.mjs",
    "test:itinerary": "esbuild scripts/test-itinerary.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/itinerary.mjs --log-level=warning && node node_modules/.cache/itinerary.mjs",
    "test:impact": "esbuild scripts/test-impact.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/impact.mjs --log-level=warning && node node_modules/.cache/impact.mjs",
    "test:railradar": "esbuild scripts/test-railradar.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/railradar.mjs --log-level=warning && node node_modules/.cache/railradar.mjs",
    "test:refund-eligibility": "esbuild scripts/test-refund-eligibility.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/refund-eligibility.mjs --log-level=warning && node node_modules/.cache/refund-eligibility.mjs",
    "test:gmail": "esbuild scripts/test-gmail-flow.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/gmail-flow.mjs --log-level=warning && node node_modules/.cache/gmail-flow.mjs",
    "test:functions": "esbuild scripts/test-gmail-functions.ts --bundle --platform=node --format=esm --external:esbuild --outfile=node_modules/.cache/gmail-functions.mjs --log-level=warning && node node_modules/.cache/gmail-functions.mjs",
    "test:refund-policy": "esbuild scripts/test-refund-policy.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/refund-policy.mjs --log-level=warning && node node_modules/.cache/refund-policy.mjs",
    "test": "npm run test:migrations && npm run test:parser && npm run test:itinerary && npm run test:impact && npm run test:railradar && npm run test:refund-eligibility && npm run test:gmail && npm run test:functions && npm run test:refund-policy",
    "test:migrations": "esbuild scripts/test-migrations.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/migrations.mjs --log-level=warning && node node_modules/.cache/migrations.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "lucide-react": "^0.542.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.25.10",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
