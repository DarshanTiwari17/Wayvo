# ---------------------------------------------------------------------------
# Wayvo — environment configuration
# Copy this file to `.env.local` and fill in the values from your Supabase
# project: Dashboard -> Project Settings -> API
#
#   cp .env.example .env.local
#
# Restart `npm run dev` after editing. Vite only reads env vars at startup.
# ---------------------------------------------------------------------------

# Your Supabase project URL. Must start with https://
# e.g. https://abcdefghijklmnopqrst.supabase.co
VITE_SUPABASE_URL=

# The *anon* / *public* key. This key is designed to be shipped to the browser
# and is safe to expose as long as Row Level Security is enabled.
# Dashboard -> Project Settings -> API -> Project API keys -> anon / public
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Where to send users after they click a link in an auth email.
# Supabase only accepts these URLs when they are added under
# Authentication -> URL Configuration -> Redirect URLs.
# ---------------------------------------------------------------------------
VITE_SUPABASE_EMAIL_REDIRECT_URL=http://localhost:5173/reset-password

# Optional: branding image for the login background.
# Defaults to the bundled /images/wayvo-waterfall.jpg
VITE_WAYVO_HERO_IMAGE=/images/wayvo-waterfall.jpg

# ---------------------------------------------------------------------------
# Optional: live weather for the Digital Twin.
#
# An OpenWeatherMap API key (https://home.openweathermap.org/api_keys). With one
# set, the Digital Twin can start a scenario from real current conditions
# instead of only hand-built ones. Without it, everything else still works.
#
# This key is compiled into the browser bundle, so restrict it to your own
# domains in the OpenWeatherMap dashboard before shipping.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# !! NEVER put the Supabase *service_role* key in this file. !!
# It bypasses Row Level Security and must never reach the browser.
# Service-role work belongs in a trusted server / Supabase Edge Function.
# ---------------------------------------------------------------------------
